# Configuração compatível com Apache 2.4
Options -Indexes
DirectoryIndex index.html index.php
RewriteEngine On
RewriteBase /

# Arquivos sensíveis nunca devem ser públicos
<FilesMatch "(^\.env|^\.user\.ini$|^\.htaccess$|\.(sql|bak|log|ini|conf|dist|sh|zip|rar|7z)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Cabeçalhos básicos de segurança
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Endpoints que precisam ser executados diretamente
RewriteRule ^api/v1/pixqr\.php$ - [L]
RewriteRule ^api/(.*)$ api/v1/api.php [QSA,L]
RewriteRule ^gold_api(.*)$ callback/game_callback [QSA,L]
RewriteRule ^infinitysoft_api(.*)$ callback/game_callback [QSA,L]
RewriteRule ^igamewin(.*)$ callback/igamewin [QSA,L]

# Rotas amigáveis do sistema
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
